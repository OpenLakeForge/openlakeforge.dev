---
import Landing from "../layouts/Landing.astro";
import Hero from "../components/landing/Hero.astro";
import LogoStrip from "../components/landing/LogoStrip.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import Why from "../components/landing/Why.astro";
import EverythingAsCode from "../components/landing/EverythingAsCode.astro";
import StagePromotion from "../components/landing/StagePromotion.astro";
import YourProject from "../components/landing/YourProject.astro";
import DeployAnywhere from "../components/landing/DeployAnywhere.astro";
