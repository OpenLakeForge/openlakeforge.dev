---
import Landing from "../layouts/Landing.astro";
import {
  floeConfigUrl,
  floeDocsUrl,
  floeInstall,
  floeRepositoryUrl,
  gate,
  sampleContract,
  sampleCsv,
  sampleRejected,
  sampleRun,
  supports,
} from "../data/floe";
import { quickstartHref } from "../lib/nav";

const clipboard = floeInstall.map((c) => c.command).join("\n");
---

<Landing
  title="Floe: a data contract gate for files"
  description="Floe validates raw files against a YAML data contract before they reach trusted storage: accepted rows go to Parquet or Iceberg, rejected rows to quarantine with the reason, and every run leaves a report. A Python package that needs no Kubernetes."
>
  <section class="top">
   <div class="wrap intro">
    <p class="eyebrow">Floe · data contract runtime · MIT</p>
    <h1 class="display">Decide what enters <span class="accent">your trusted layer.</span></h1>
    <p class="lede">
      Floe validates raw files or extracted datasets before they reach your trusted storage. Accepted rows go to
      Parquet or Iceberg, rejected rows to quarantine with the reason, and every run leaves a report. It is a Python
      package: install it, write a contract, run it. No Kubernetes needed.
    </p>
    <pre class="terminal"><code>{floeInstall.map(({ command, comment }) => (
      <span class="line"><span class="prompt">$ </span>{command}<span class="comment">   # {comment}</span></span>
    ))}</code></pre>
    <div class="actions">
      <a class="btn btn-primary" href={floeDocsUrl}>Read the docs <span aria-hidden="true">→</span></a>
      <a class="btn btn-secondary" href={floeRepositoryUrl}>Floe on GitHub <span aria-hidden="true">→</span></a>
    </div>
    <button class="copy" type="button" data-copy={clipboard}>[ Copy commands ]</button>
   </div>
  </section>

  <section class="wrap section" id="gate">
    <div class="section-head">
      <p class="eyebrow">What it does</p>
      <h2 class="title">A gate in front of the tables you trust.</h2>
      <p class="lede">
        Extract and load tools such as dlt, ingestr and Airbyte get data out of source systems. Floe decides what is
        allowed in.
      </p>
    </div>
    <div class="grid grid-3">
      {gate.map(({ title, text }) => (
        <article class="card">
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section" id="try-it">
    <div class="section-head">
      <p class="eyebrow">Try it</p>
      <h2 class="title">One contract, one file, one command.</h2>
      <p class="lede">
        This contract expects a unique, non-empty <code>order_id</code> and a decimal <code>amount</code>. The CSV
        separator is set because Floe reads <code>;</code> unless told otherwise. Output below comes from
        floe-python 0.10.1.
      </p>
    </div>
    <div class="try">
      <figure>
        <figcaption>in/orders.csv</figcaption>
        <pre class="terminal"><code>{sampleCsv}</code></pre>
      </figure>
      <figure>
        <figcaption>floe.yml</figcaption>
        <pre class="terminal"><code>{sampleContract}</code></pre>
      </figure>
      <figure class="wide">
        <figcaption>floe run -c floe.yml</figcaption>
        <pre class="terminal"><code>{sampleRun}</code></pre>
        <p class="note">
          Two rows reach <code>out/accepted/orders</code> as Parquet. The second <code>1003</code> is rejected as a
          duplicate; the first one stays.
        </p>
      </figure>
      <figure class="wide">
        <figcaption>out/rejected/orders/part-00000.csv</figcaption>
        <pre class="terminal"><code>{sampleRejected}</code></pre>
      </figure>
    </div>
    <p class="more">
      <a href={floeConfigUrl}>Contract reference <span aria-hidden="true">→</span></a>
    </p>
  </section>

  <section class="wrap section" id="supports">
    <div class="section-head">
      <p class="eyebrow">Inputs and outputs</p>
      <h2 class="title">Small surface, on purpose.</h2>
    </div>
    <dl class="supports">
      {supports.map(({ label, value }) => (
        <div class="row">
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap section" id="olf">
    <div class="section-head">
      <p class="eyebrow">Grow into OpenLakeForge</p>
      <h2 class="title">The same contracts, a whole lakehouse around them.</h2>
      <p class="lede">
        In OpenLakeForge, Floe is the Silver gate. dlt lands Bronze files, Floe validates each domain into Iceberg
        tables through Polaris as one Kubernetes Job per domain, and dbt builds the Gold marts. The contract you
        wrote here is the shape of the contracts a domain keeps in <code>silver/&lt;domain&gt;/contracts/</code>.
      </p>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href="/docs/architecture/floe-validation/">How Silver validation works <span aria-hidden="true">→</span></a>
      <a class="btn btn-secondary" href={quickstartHref}>OpenLakeForge quick start <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Landing>

<script>
  document.querySelector<HTMLButtonElement>(".copy")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "[ Copied ]";
    } catch {
      button.textContent = "[ Select the text above ]";
    }
    setTimeout(() => (button.textContent = "[ Copy commands ]"), 2000);
  });
</script>

<style>
  /* Not on .intro: .wrap (landing.css) sets the vertical padding and margin to 0 and can win the cascade. */
  .top { padding-top: var(--olf-space-24); }
  .intro { display: flex; flex-direction: column; align-items: flex-start; gap: var(--olf-space-6); }
  .intro .lede { max-width: 46rem; }
  .intro .terminal { align-self: stretch; max-width: 44rem; }
  .line { display: block; white-space: pre; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--olf-space-4); }
  .copy {
    margin-top: calc(var(--olf-space-2) * -1);
    padding: 0;
    border: 0;
    background: none;
    font: 500 0.6875rem / 1.4 var(--olf-font-mono);
    letter-spacing: var(--olf-tracking-label);
    text-transform: uppercase;
    color: var(--olf-text-muted);
    cursor: pointer;
  }
  .copy:hover { color: var(--olf-text-primary); }
  .try { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--olf-space-5); align-items: start; }
  .try .wide { grid-column: 1 / -1; }
  figure { margin: 0; min-width: 0; display: flex; flex-direction: column; gap: var(--olf-space-3); }
  figcaption { font: 500 0.6875rem / 1.4 var(--olf-font-mono); letter-spacing: var(--olf-tracking-label); text-transform: uppercase; color: var(--olf-text-muted); }
  .note { margin: 0; font-size: var(--olf-text-small); line-height: 1.57; color: var(--olf-text-secondary); }
  .more { margin: var(--olf-space-6) 0 0; }
  .more a { font: 500 0.8125rem / 1 var(--olf-font-mono); letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; }
  .lede code, .note code { font: var(--olf-text-code) / 1.4 var(--olf-font-mono); color: var(--olf-link); }
  .supports { display: grid; gap: 0; margin: 0; border: 1px solid var(--olf-border-default); border-radius: var(--olf-radius-lg); background: var(--olf-bg-surface); }
  .row { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: var(--olf-space-4); padding: var(--olf-space-4) var(--olf-space-6); }
  .row + .row { border-top: 1px solid var(--olf-border-subtle); }
  dt { font: 500 0.6875rem / 1.9 var(--olf-font-mono); letter-spacing: var(--olf-tracking-label); text-transform: uppercase; color: var(--olf-text-muted); }
  dd { margin: 0; color: var(--olf-text-secondary); }
  @media (max-width: 40rem) {
    .top { padding-top: var(--olf-space-12); }
    .try { grid-template-columns: minmax(0, 1fr); }
    .row { grid-template-columns: 1fr; gap: var(--olf-space-1); }
  }
</style>
