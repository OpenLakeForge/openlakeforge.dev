---
/** Starlight override: the OpenLakeForge mark and wordmark ("Lake" in highlight), then "Floe" on the Floe docs. */
import Mark from "../Mark.astro";

const { siteTitleHref } = Astro.locals.starlightRoute;
const floe = Astro.url.pathname.startsWith("/floe/");
---

<div class="site-title">
  <a href={siteTitleHref} class="site-title">
    <Mark size="2rem" />
    <span class="wordmark" translate="no">Open<span>Lake</span>Forge</span>
  </a>
  {floe && <a href="/floe/" class="product" translate="no">Floe</a>}
</div>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: var(--olf-space-3);
    color: var(--olf-text-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark {
    font: 700 var(--olf-text-h4) / 1 var(--olf-font-heading);
    letter-spacing: -0.01em;
  }
  .wordmark span {
    color: var(--olf-highlight);
  }
  .product {
    padding-inline-start: var(--olf-space-3);
    border-inline-start: 1px solid var(--olf-border-default);
    font: 500 var(--olf-text-h4) / 1 var(--olf-font-heading);
    color: var(--olf-text-secondary);
    text-decoration: none;
  }
  .product:hover {
    color: var(--olf-text-primary);
  }
</style>
