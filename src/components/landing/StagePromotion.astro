---
import ThemedChart from "./ThemedChart.astro";
import dark from "../../assets/charts/stage-promotion-dark.svg";
import light from "../../assets/charts/stage-promotion-light.svg";
---

<section class="wrap section" id="stages">
  <div class="section-head">
    <p class="eyebrow">Stages</p>
    <h2 class="title">From a commit to PROD, built once.</h2>
    <p class="lede">
      A change is built once into an immutable project revision, activated in DEV, tested, approved, then activated
      unchanged in PROD. PROD never rebuilds, and no data is copied between stages.
    </p>
  </div>
  <ThemedChart
    dark={dark}
    light={light}
    alt="Stage promotion: a merged pull request builds one image and one project revision, which is activated in the DEV namespace, tested, approved, and then activated unchanged in PROD"
  />
</section>
