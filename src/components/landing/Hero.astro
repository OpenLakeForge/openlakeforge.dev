---
import Mark from "../Mark.astro";
import { installCommands } from "../../data/landing";
import { quickstartHref, repositoryUrl } from "../../lib/nav";

// Lake-bed depth contours: one outline, scaled and turned.
const outline = "M0-100C70-104 130-70 150-20S135 85 70 102-55 118-110 80-160-10-120-60-55-97 0-100Z";
const rings = [[0.6, 8, 0.9], [1.1, 4, 0.8], [1.7, -2, 0.7], [2.4, -7, 0.6], [3.2, -11, 0.5], [4.1, -14, 0.4], [5.1, -16, 0.3], [6.3, -18, 0.2], [7.6, -20, 0.15], [9, -22, 0.1]];
const clipboard = installCommands.map((c) => c.command).join("\n");
---

<section class="hero" id="surface" data-tone="shallow">
  <!-- The rings and the pointer's wake, fading out toward the hero's bottom. -->
  <div class="water" aria-hidden="true">
    <canvas class="wake" data-wake aria-hidden="true"></canvas>
    <svg class="contours" viewBox="0 0 1200 800" aria-hidden="true">
      <g fill="none" stroke="currentColor" transform="translate(600 380)">
        {rings.map(([s, r, o], i) => (
          <g transform={`scale(${s}) rotate(${r})`} opacity={o} style={`--i: ${i}`}>
            <path d={outline} stroke-width="2.5" vector-effect="non-scaling-stroke" />
          </g>
        ))}
      </g>
    </svg>
  </div>
  <div class="wrap content">
    <Mark size="5.5rem" />
    <p class="eyebrow">Open-source lakehouse · Apache-2.0 · Alpha</p>
    <h1 class="display">Your modern lakehouse,<br /><span class="accent">forged in one command.</span></h1>
    <p class="lede">
      OpenLakeForge is the open-source lakehouse for small data teams. Ingestion, validation, Iceberg storage, SQL,
      orchestration, governance and dashboards come assembled, wired and deployed, on your laptop, AWS or Azure.
    </p>
    <div class="install">
      <pre class="terminal"><code>{installCommands.map(({ command, comment }) => (
        <span class="line"><span class="prompt">$ </span>{command}{comment && <span class="comment">   # {comment}</span>}</span>
      ))}</code></pre>
      <button class="copy" type="button" data-copy={clipboard}>[ Copy ]</button>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href={quickstartHref}>Quick start <span aria-hidden="true">→</span></a>
      <a class="btn btn-secondary" href={repositoryUrl}>Star on GitHub <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<script>
  // The pointer is a stick trailed through the surface water, the hero only:
  // a small height-field wave simulation (the jQuery Ripples algorithm) on a
  // grid of 4 px cells. The pointer pushes the surface down along its path;
  // the waves spread, cross and fade by themselves, and the loop stops once
  // the water is still. Drawn like toon water (Wind Waker, Ghibli): a line
  // along each crest's and trough's contour, in the rings' colour. The canvas
  // is drawn at 1 px, heights interpolated between cells, so the lines stay
  // smooth.
  type Box = { x: number; y: number; x2: number; y2: number };
  const hero = document.querySelector<HTMLElement>(".hero")!;
  const canvas = hero.querySelector<HTMLCanvasElement>("[data-wake]")!;
  const ctx = canvas.getContext("2d")!;
  // Checked again on every move and frame, so turning on reduced motion with
  // the page open stops the wake at once.
  const motion = matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)");
  if (motion.matches) {
    const CELL = 4, SUB = 4; // simulation cell in CSS px, drawn pixels per cell
    const DAMPING = 0.94; // per frame: the wake's length
    const LEVEL = 0.06; // the contour height the foam line follows
    // Panels the wake runs under: it is cut out where one lies, even a
    // translucent one, so it never shows through code, buttons or bars.
    const COVERS = ".terminal, .btn, .copy, body > header, [data-gauge], [data-board]";
    const smooth = (a: number, b: number, v: number) => { const t = Math.min(Math.max((v - a) / (b - a), 0), 1); return t * t * (3 - 2 * t); };
    let cols = 0, rows = 0, image = ctx.createImageData(1, 1);
    let now = new Float32Array(0), before = now, height = now, slope = now, active = new Uint8Array(0);
    let drawn: Box | null = null; // the pixels drawn last frame, cleared on the next
    let running = false, last: { x: number; y: number } | null = null;
    let color = [92, 201, 255], opacity = 0.22;

    const fit = () => {
      cols = Math.ceil(hero.clientWidth / CELL);
      rows = Math.ceil(hero.clientHeight / CELL);
      canvas.width = cols * SUB;
      canvas.height = rows * SUB;
      [now, before, height, slope] = [0, 1, 2, 3].map(() => new Float32Array(cols * rows));
      active = new Uint8Array(cols * rows);
      image = ctx.createImageData(canvas.width, canvas.height);
      drawn = null;
    };
    new ResizeObserver(fit).observe(hero);

    // The rings' colour and opacity, read again on every theme switch, even
    // while the water still moves.
    const readTheme = () => {
      const style = getComputedStyle(hero), hex = (style.getPropertyValue("--ripple") || style.getPropertyValue("--olf-highlight")).trim();
      if (/^#[0-9a-f]{6}$/i.test(hex)) color = [1, 3, 5].map((k) => parseInt(hex.slice(k, k + 2), 16));
      opacity = parseFloat(style.getPropertyValue("--contour-opacity")) || opacity;
    };
    readTheme();
    new MutationObserver(readTheme).observe(document.documentElement, { attributeFilter: ["data-theme"] });

    // A round stick, softer at its edge, pushing the surface down.
    const push = (x: number, y: number) => {
      const cx = Math.round(x / CELL), cy = Math.round(y / CELL);
      for (let dy = -2; dy <= 2; dy++) for (let dx = -2; dx <= 2; dx++) {
        const d2 = (dx * dx + dy * dy) / 4, x0 = cx + dx, y0 = cy + dy;
        if (d2 < 1 && x0 > 0 && x0 < cols - 1 && y0 > 0 && y0 < rows - 1) now[y0 * cols + x0] -= 0.05 * (1 - d2);
      }
    };

    // One step of the wave equation; returns the moving cells' bounding box.
    const simulate = (): Box | null => {
      let x1 = cols, y1 = rows, x2 = -1, y2 = -1;
      for (let y = 1; y < rows - 1; y++) for (let x = 1; x < cols - 1; x++) {
        const i = y * cols + x;
        const h = ((now[i - 1] + now[i + 1] + now[i - cols] + now[i + cols]) / 2 - before[i]) * DAMPING;
        before[i] = h;
        if (h > 0.002 || h < -0.002) { x1 = Math.min(x1, x); x2 = Math.max(x2, x); y1 = Math.min(y1, y); y2 = Math.max(y2, y); }
      }
      [now, before] = [before, now];
      return x2 < 0 ? null : { x: x1, y: y1, x2, y2 };
    };

    // Smoothed height, its slope and "could show anything" for the box's
    // cells and the ring around them that the drawn pixels sample. The
    // height takes a 3×3 Gaussian blur: the simulation's grain would
    // otherwise ripple the lines' edges cell by cell.
    const derive = ({ x, y, x2, y2 }: Box) => {
      const ya = Math.max(y - 3, 1), yb = Math.min(y2 + 3, rows - 2), xa = Math.max(x - 3, 1), xb = Math.min(x2 + 3, cols - 2);
      for (let cy = ya; cy <= yb; cy++) for (let cx = xa; cx <= xb; cx++) {
        const i = cy * cols + cx;
        height[i] = (4 * now[i] + 2 * (now[i - 1] + now[i + 1] + now[i - cols] + now[i + cols]) + now[i - cols - 1] + now[i - cols + 1] + now[i + cols - 1] + now[i + cols + 1]) / 16;
      }
      for (let cy = ya + 1; cy < yb; cy++) for (let cx = xa + 1; cx < xb; cx++) {
        const i = cy * cols + cx;
        slope[i] = Math.hypot(height[i + 1] - height[i - 1], height[i + cols] - height[i - cols]) / 2;
        active[i] = slope[i] > 0.015 ? 1 : 0; // could carry foam
      }
    };

    const paint = (cells: Box): Box => {
      const px = image.data, w = canvas.width;
      const box = { x: Math.max((cells.x - 1) * SUB, 0), y: Math.max((cells.y - 1) * SUB, 0), x2: Math.min((cells.x2 + 2) * SUB, w), y2: Math.min((cells.y2 + 2) * SUB, canvas.height) };
      for (let ry = box.y; ry < box.y2; ry++) {
        const fy = Math.min(Math.max((ry + 0.5) / SUB - 0.5, 0), rows - 1.001), y0 = fy | 0, ty = fy - y0;
        for (let rx = box.x; rx < box.x2; rx++) {
          const fx = Math.min(Math.max((rx + 0.5) / SUB - 0.5, 0), cols - 1.001), x0 = fx | 0, tx = fx - x0;
          const i = y0 * cols + x0, o = (ry * w + rx) * 4;
          if (!(active[i] | active[i + 1] | active[i + cols] | active[i + cols + 1])) continue; // calm: stays clear
          const a = (1 - tx) * (1 - ty), b = tx * (1 - ty), c = (1 - tx) * ty, d = tx * ty;
          const h = height[i] * a + height[i + 1] * b + height[i + cols] * c + height[i + cols + 1] * d;
          const s = slope[i] * a + slope[i + 1] * b + slope[i + cols] * c + slope[i + cols + 1] * d;
          // Distance in cells to the contour (height over slope), so the line
          // keeps one width however steep the wave; only where the surface
          // still slopes, or a flattening wave would blot into patches.
          const foam = (1 - smooth(0.35, 0.6, Math.abs((Math.abs(h) - LEVEL) / Math.max(s, 0.01)))) * smooth(0.015, 0.03, s);
          if (foam > 0.01) { px[o] = color[0]; px[o + 1] = color[1]; px[o + 2] = color[2]; px[o + 3] = foam * opacity * 255; }
        }
      }
      return box;
    };

    const frame = () => {
      const cells = simulate();
      const px = image.data, w = canvas.width;
      if (drawn) for (let ry = drawn.y; ry < drawn.y2; ry++) px.fill(0, (ry * w + drawn.x) * 4, (ry * w + drawn.x2) * 4);
      if (cells) derive(cells);
      const box = cells && paint(cells);
      const dirty = [box, drawn].filter((b): b is Box => !!b);
      if (dirty.length) {
        const x = Math.min(...dirty.map((b) => b.x)), y = Math.min(...dirty.map((b) => b.y));
        ctx.putImageData(image, 0, 0, x, y, Math.max(...dirty.map((b) => b.x2)) - x, Math.max(...dirty.map((b) => b.y2)) - y);
      }
      drawn = box;
      const origin = canvas.getBoundingClientRect();
      ctx.save();
      ctx.globalCompositeOperation = "destination-out";
      ctx.setTransform(1 / (CELL / SUB), 0, 0, 1 / (CELL / SUB), 0, 0);
      ctx.beginPath();
      for (const el of document.querySelectorAll(COVERS)) {
        const r = el.getBoundingClientRect();
        if (r.width && r.bottom > origin.top && r.top < origin.bottom) ctx.roundRect(r.x - origin.x, r.y - origin.y, r.width, r.height, parseFloat(getComputedStyle(el).borderTopLeftRadius) || 0);
      }
      ctx.fill();
      ctx.restore();
      if (cells && motion.matches) requestAnimationFrame(frame);
      else {
        running = false;
        drawn = null;
        [now, before, image.data].forEach((a) => a.fill(0));
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    };

    hero.addEventListener("pointermove", (e) => {
      if (!motion.matches) return;
      const origin = canvas.getBoundingClientRect(), x = e.clientX - origin.x, y = e.clientY - origin.y;
      // Every cell along the path, so a fast stroke still leaves one wake.
      const steps = last ? Math.min(Math.ceil(Math.hypot(x - last.x, y - last.y) / CELL), 50) : 1;
      for (let s = 1; s <= steps; s++) push(last ? last.x + ((x - last.x) * s) / steps : x, last ? last.y + ((y - last.y) * s) / steps : y);
      last = { x, y };
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    }, { passive: true });
    hero.addEventListener("pointerleave", () => (last = null));
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".hero .copy")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "[ Copied ]";
        setTimeout(() => (button.textContent = "[ Copy ]"), 1600);
      } catch {}
    });
  }
</script>

<style>
  .hero { position: relative; overflow: hidden; }
  .water { position: absolute; inset: 0; pointer-events: none; mask-image: linear-gradient(#000 60%, transparent); }
  .wake { position: absolute; inset: 0; width: 100%; height: 100%; }
  .contours {
    position: absolute;
    left: 50%;
    top: -16rem;
    width: 112rem;
    max-width: none;
    transform: translateX(-50%);
    color: var(--ripple, var(--olf-highlight));
    opacity: var(--contour-opacity);
    pointer-events: none;
  }
  /* Ripples: each ring rises at the centre, spreads outward and fades, one
     every 2 s. With reduced motion the rings stay as still depth contours. */
  @media (prefers-reduced-motion: no-preference) {
    .contours g g { animation: ripple 20s linear calc(var(--i) * -2s) infinite; }
  }
  @keyframes ripple {
    from { transform: scale(0.3) rotate(10deg); opacity: 0; }
    8% { opacity: 1; }
    to { transform: scale(10) rotate(-24deg); opacity: 0; }
  }
  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--olf-space-6);
    padding-top: var(--olf-space-24);
    padding-bottom: var(--olf-space-8);
    text-align: center;
  }
  .lede { max-width: 45rem; }
  .install { position: relative; width: min(100%, 42rem); }
  .install .terminal { padding-right: var(--olf-space-24); }
  .line { display: block; white-space: pre; }
  .copy {
    position: absolute;
    top: var(--olf-space-4);
    right: var(--olf-space-4);
    border: 0;
    background: none;
    font: 500 0.6875rem / 1 var(--olf-font-mono);
    letter-spacing: var(--olf-tracking-label);
    text-transform: uppercase;
    color: var(--abyss-400);
    cursor: pointer;
  }
  .copy:hover { color: var(--abyss-100); }
  .actions { justify-content: center; }
  @media (max-width: 48rem) {
    .content { padding-top: var(--olf-space-16); }
    .comment { display: none; }
    /* The copy button gets its own row above the commands. */
    .install .terminal { padding-top: var(--olf-space-10); padding-right: var(--olf-space-6); }
    .copy { top: var(--olf-space-3); }
  }
</style>
