---
/** A README chart: the dark and light renders, the one matching the theme shown. */
import type { ImageMetadata } from "astro";

interface Props {
  dark: ImageMetadata;
  light: ImageMetadata;
  alt: string;
}
const { dark, light, alt } = Astro.props;
---

<figure class="chart">
  <img class="only-dark" src={dark.src} width={dark.width} height={dark.height} alt={alt} loading="lazy" decoding="async" />
  <img class="only-light" src={light.src} width={light.width} height={light.height} alt={alt} loading="lazy" decoding="async" />
</figure>

<style>
  figure { margin: 0; }
</style>
