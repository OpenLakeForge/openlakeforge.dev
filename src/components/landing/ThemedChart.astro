---
/** A README chart: the dark and light renders, the one matching the theme shown. */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  dark: ImageMetadata;
  light: ImageMetadata;
  alt: string;
}
const { dark, light, alt } = Astro.props;
---

<figure class="chart">
  <Image class="only-dark" src={dark} alt={alt} loading="lazy" decoding="async" />
  <Image class="only-light" src={light} alt={alt} loading="lazy" decoding="async" />
</figure>

<style>
  figure { margin: 0; }
</style>
