---
/**
 * The page's depth gauge, after the scroll ruler on getartcraft.com/apps:
 * a strip on the right edge with a ruler in metres that slides under a fixed
 * reading line as the page scrolls. Each section sits ten metres below the
 * previous one (00 m Surface … 80 m Get started), so the reading is both a
 * progress bar and a map. A rolling readout at the top shows the depth, and
 * a split-flap board below it the current section's name;
 * hovering the ruler shows the depth under the cursor, and a click dives there.
 *
 * From 64rem wide the page reserves a column for the strip. Below that (tablets,
 * phones) there is no room for it: a "Sections" button at the
 * bottom opens the same list instead.
 */
import { sections } from "../../data/landing";

const metresPerSection = 10;
const maxDepth = (sections.length - 1) * metresPerSection;
const ticks = Array.from({ length: maxDepth + 1 }, (_, m) => m);
const digits = Array.from({ length: 10 }, (_, d) => d);
// The flap is as wide as the longest name, so the board never resizes.
const boardChars = Math.max(...sections.map((s) => s.label.length));
---

<div class="gauge" data-gauge data-max-depth={maxDepth} data-step={metresPerSection} style={`--max: ${maxDepth}`}>
  <!-- The keyboard and screen-reader way in: the ruler below is a pointer-only
       picture whose links slide out of view, so they are not tab stops. This
       list is invisible until it receives focus, then opens beside the strip. -->
  <nav class="keys" aria-label="Page sections">
    <ol>
      {sections.map(({ id, label, depth }) => (
        <li><a href={`#${id}`} data-section={id}><span class="depth">{depth}</span>{label}</a></li>
      ))}
    </ol>
  </nav>

  <div class="readout" data-tone="shallow" aria-hidden="true">
    <span class="caption">Depth</span>
    <span class="value">
      <span class="roll" data-roll="tens">{digits.map((d) => <span>{d}</span>)}</span>
      <span class="roll" data-roll="units">{digits.map((d) => <span>{d}</span>)}</span>
      <span class="unit">m</span>
    </span>
  </div>

  <!-- The current section's name on one split-flap tile hanging from the
       readout, like a station departure board: the old name's top half falls
       forward, then the new name's bottom half swings down. Static halves
       show the new top and the old bottom behind the two folding ones. -->
  <div class="board" data-board data-tone="shallow" data-labels={JSON.stringify(sections.map((s) => s.label))} style={`--chars: ${boardChars}`} aria-hidden="true">
    <span class="half top" data-half="top"><span></span></span>
    <span class="half bottom" data-half="bottom"><span></span></span>
    <span class="half top fold" data-half="fold-top"><span></span></span>
    <span class="half bottom fold" data-half="fold-bottom"><span></span></span>
  </div>

  <div class="window" data-window>
    <div class="ruler" data-ruler>
      {ticks.map((m) => (
        <span
          class:list={["tick", { mid: m % 5 === 0, major: m % metresPerSection === 0 }]}
          style={`--m: ${m}`}
          data-tone="shallow"
          aria-hidden="true"
        />
      ))}
      <ol aria-hidden="true">
        {sections.map(({ id }, i) => (
          <li style={`--m: ${i * metresPerSection}`} data-tone="shallow">
            <a href={`#${id}`} data-section={id} tabindex="-1">{String(i * metresPerSection).padStart(2, "0")}</a>
          </li>
        ))}
      </ol>
    </div>
    <span class="level" data-tone="shallow" aria-hidden="true"><span class="grip"></span></span>
    <span class="probe" data-probe data-tone="shallow" aria-hidden="true"><span data-probe-depth>0 m</span></span>
  </div>
</div>

<details class="jump" data-jump data-tone="shallow">
  <summary><span class="depth" data-jump-depth>00 m</span> Sections</summary>
  <ol>
    {sections.map(({ id, label, depth }) => (
      <li><a href={`#${id}`} data-section={id}><span class="depth">{depth}</span>{label}</a></li>
    ))}
  </ol>
</details>

<script>
  const gauge = document.querySelector<HTMLElement>("[data-gauge]")!;
  const win = gauge.querySelector<HTMLElement>("[data-window]")!;
  const probe = gauge.querySelector<HTMLElement>("[data-probe]")!;
  const probeDepth = gauge.querySelector<HTMLElement>("[data-probe-depth]")!;
  const rolls = { tens: gauge.querySelector<HTMLElement>('[data-roll="tens"]')!, units: gauge.querySelector<HTMLElement>('[data-roll="units"]')! };
  const jump = document.querySelector<HTMLDetailsElement>("[data-jump]");
  const jumpDepth = document.querySelector<HTMLElement>("[data-jump-depth]");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-section]")];
  const ids = [...new Set(links.map((a) => a.dataset.section!))];
  const targets = ids.map((id) => document.getElementById(id)!);
  const step = Number(gauge.dataset.step);
  const maxDepth = Number(gauge.dataset.maxDepth);
  // Anchor points between scroll position and depth: section i is at
  // i × step metres where a jump to it lands, i.e. its top minus its
  // scroll-margin-top (read from CSS, so a larger root font size moves both
  // together). Sections that cannot scroll that far are clamped to the
  // bottom of the page. Recomputed when the layout changes.
  let anchors: { y: number; d: number }[] = [];
  const measure = () => {
    const maxScroll = document.documentElement.scrollHeight - innerHeight;
    anchors = targets.map((t, i) => ({
      y: i === 0 ? 0 : Math.min(maxScroll, Math.max(0, t.getBoundingClientRect().top + scrollY - parseFloat(getComputedStyle(t).scrollMarginTop))),
      d: i * step,
    }));
    for (let i = anchors.length - 2; i >= 0; i--) anchors[i].y = Math.min(anchors[i].y, anchors[i + 1].y);
    // On a tall screen several of them collapse onto the bottom. Spread each
    // run of equal positions evenly back to the previous anchor, so depth
    // keeps rising continuously (and every depth can be dived to) instead of
    // jumping across the run on the last pixel.
    for (let s = 1; s < anchors.length; ) {
      let e = s;
      while (e + 1 < anchors.length && anchors[e + 1].y === anchors[s].y) e++;
      const lo = anchors[s - 1].y, hi = anchors[e].y, n = e - s + 1;
      if (n > 1 && hi > lo) for (let j = 0; j < n; j++) anchors[s + j].y = lo + ((hi - lo) * (j + 1)) / n;
      s = e + 1;
    }
  };
  const interpolate = (x: number, from: "y" | "d", to: "y" | "d") => {
    if (x <= anchors[0][from]) return anchors[0][to];
    for (let i = 1; i < anchors.length; i++) {
      const a = anchors[i - 1], b = anchors[i];
      if (x <= b[from]) return b[from] === a[from] ? b[to] : a[to] + ((x - a[from]) / (b[from] - a[from])) * (b[to] - a[to]);
    }
    return anchors[anchors.length - 1][to];
  };
  // The anchors are strictly increasing once measured, so both directions are
  // plain interpolations; past the last anchor (the bottom), the deepest depth.
  const depthAt = (y: number) => interpolate(y, "y", "d");
  const scrollFor = (d: number) => interpolate(d, "d", "y");

  // The readout lines up with the page header: same top (the header sits
  // below the announcement bar until it sticks) and same height.
  const header = document.querySelector<HTMLElement>("body > header");
  const alignWithHeader = () => {
    if (!header) return;
    const r = header.getBoundingClientRect();
    gauge.style.setProperty("--top", `${Math.max(0, r.top)}px`);
    gauge.style.setProperty("--head", `${r.height}px`);
  };

  // Split-flap board: one tile flips from the old name to the new one. The
  // first name, and every name under reduced motion, is set without a flip.
  const board = gauge.querySelector<HTMLElement>("[data-board]")!;
  const labels: string[] = JSON.parse(board.dataset.labels!);
  const half = (name: string) => board.querySelector<HTMLElement>(`[data-half="${name}"] > span`)!;
  const halves = { top: half("top"), bottom: half("bottom"), foldTop: half("fold-top"), foldBottom: half("fold-bottom") };
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  let shown = "";
  let settle = 0;
  const setBoard = (text: string) => {
    clearTimeout(settle);
    const old = shown;
    shown = text;
    board.classList.remove("flipping");
    if (!old || still.matches) {
      for (const h of Object.values(halves)) h.textContent = text;
      return;
    }
    halves.top.textContent = text;
    halves.bottom.textContent = old;
    halves.foldTop.textContent = old;
    halves.foldBottom.textContent = text;
    void board.offsetWidth; // restart the animation
    board.classList.add("flipping");
    settle = setTimeout(() => {
      halves.bottom.textContent = text;
      board.classList.remove("flipping");
    }, 360);
  };

  let current = -1;
  const update = () => {
    alignWithHeader();
    const depth = depthAt(scrollY);
    gauge.style.setProperty("--depth", depth.toFixed(2));
    const shown = Math.min(maxDepth, Math.round(depth));
    rolls.tens.style.setProperty("--digit", String(Math.floor(shown / 10)));
    rolls.units.style.setProperty("--digit", String(shown % 10));

    // 0.1 m of tolerance: pixel-snapped scrolling can stop a hair above a depth.
    const index = Math.min(ids.length - 1, Math.floor((depth + 0.1) / step));
    if (index === current) return;
    current = index;
    setBoard(labels[index]);
    for (const a of links) {
      if (a.dataset.section === ids[index]) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    }
    // The bottom button stays out of the way (and out of the tab order) on the hero.
    if (jump) {
      jump.toggleAttribute("data-surfaced", index === 0);
      jump.inert = index === 0;
      if (index === 0) jump.open = false;
    }
    if (jumpDepth) jumpDepth.textContent = `${String(index * step).padStart(2, "0")} m`;
  };

  // The ruler is the page's scrollbar: 0 m at its top, the deepest section at
  // its bottom, inside --pad-top / --pad-bottom (rem). Hovering reads the depth
  // under the cursor; pressing moves the level there, and dragging scrolls.
  const remPx = (name: string) =>
    parseFloat(getComputedStyle(win).getPropertyValue(name)) * parseFloat(getComputedStyle(document.documentElement).fontSize);
  const depthUnder = (clientY: number) => {
    const r = win.getBoundingClientRect();
    const top = remPx("--pad-top"), bottom = remPx("--pad-bottom");
    const span = r.height - top - bottom;
    if (span <= 0) return depthAt(scrollY); // no track to read: stay put
    const d = ((clientY - r.top - top) / span) * maxDepth;
    return Math.min(maxDepth, Math.max(0, d));
  };
  const scrollToDepth = (clientY: number) => scrollTo({ top: scrollFor(depthUnder(clientY)), behavior: "instant" });
  let dragging = false;
  win.addEventListener("pointerdown", (e) => {
    if (e.button !== 0 || (e.target as HTMLElement).closest("a")) return; // section links have their own handler
    e.preventDefault();
    dragging = true;
    win.setPointerCapture(e.pointerId);
    gauge.toggleAttribute("data-dragging", true);
    scrollToDepth(e.clientY);
  });
  win.addEventListener("pointermove", (e) => {
    const r = win.getBoundingClientRect();
    probe.style.setProperty("--y", `${Math.min(r.height, Math.max(0, e.clientY - r.top))}px`);
    probeDepth.textContent = `${Math.round(depthUnder(e.clientY))} m`;
    if (dragging) scrollToDepth(e.clientY);
  });
  const stopDrag = (e: PointerEvent) => {
    if (!dragging) return;
    dragging = false;
    if (win.hasPointerCapture(e.pointerId)) win.releasePointerCapture(e.pointerId);
    gauge.toggleAttribute("data-dragging", false);
  };
  win.addEventListener("pointerup", stopDrag);
  win.addEventListener("pointercancel", stopDrag);

  jump?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) jump.open = false;
  });

  // Every way to a section goes through the same mapping as the gauge.
  // Usually that is exactly where the native jump lands (top minus
  // scroll-margin); on a tall screen, where trailing sections are clamped and
  // spread, the native jump would land at the bottom and read the last section.
  // Spread positions are fractional and scrolling snaps to whole pixels: round
  // up so a jump lands on (not just above) the section's depth.
  const landingY = (index: number) => Math.ceil(scrollFor(index * step));
  const goTo = (index: number, behavior: ScrollBehavior = "auto") => {
    scrollTo({ top: landingY(index), behavior });
    targets[index].setAttribute("tabindex", "-1");
    targets[index].focus({ preventScroll: true });
  };
  // Index of the section named by the URL fragment, or -1. A malformed
  // fragment such as "#%" makes decodeURIComponent throw: treat it as unknown.
  const sectionInHash = () => {
    try {
      return ids.indexOf(decodeURIComponent(location.hash.slice(1)));
    } catch {
      return -1;
    }
  };
  // Where the browser's own fragment jump puts a section.
  const nativeY = (index: number) => Math.min(
    document.documentElement.scrollHeight - innerHeight,
    Math.max(0, targets[index].getBoundingClientRect().top + scrollY - parseFloat(getComputedStyle(targets[index]).scrollMarginTop)),
  );

  // History: each entry keeps the reader's scroll position in history.state
  // (olfY), refreshed while scrolling and written just before a section jump.
  // Back and Forward restore it explicitly: on a tall screen the browser would
  // otherwise jump to the entry's fragment (the bottom) instead.
  // history.state is written at most every 250 ms (browsers throttle it), so
  // Back within that time would leave a stale olfY. Where the Navigation API
  // exists, positions are also kept in memory per entry, on every scroll, and
  // take precedence.
  const entryKey = () =>
    (window as { navigation?: { currentEntry?: { key: string } } }).navigation?.currentEntry?.key;
  const positions = new Map<string, number>();
  let restoring = false;
  const track = () => {
    const key = entryKey();
    if (key) positions.set(key, scrollY);
  };
  const remember = () => {
    history.replaceState({ ...(history.state ?? {}), olfY: scrollY }, "");
  };
  let rememberTimer = 0;
  addEventListener("scroll", () => {
    if (!restoring) track();
    clearTimeout(rememberTimer);
    rememberTimer = setTimeout(remember, 250);
  }, { passive: true });

  // Clicks on section links (ruler, keyboard list, mobile list): pushState
  // keeps the #hash in history without a second, native jump.
  for (const a of links) {
    a.addEventListener("click", (e) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // new tab etc.
      const index = ids.indexOf(a.dataset.section!);
      e.preventDefault();
      clearTimeout(rememberTimer);
      remember();
      goTo(index);
      const url = `#${ids[index]}`;
      if (location.hash !== url) history.pushState({ olfY: scrollY }, "", url);
      else remember();
      track();
    });
  }

  // Back/Forward to an entry with a remembered position: restore it after the
  // browser's own handling, and ignore the hashchange the traversal fires.
  addEventListener("popstate", (e) => {
    const key = entryKey();
    const y = (key && positions.get(key)) ?? (e.state as { olfY?: unknown } | null)?.olfY;
    if (typeof y !== "number") return;
    restoring = true;
    setTimeout(() => {
      scrollTo({ top: y, behavior: "instant" });
      restoring = false;
      track();
    }, 0);
  });

  // Any other fragment navigation (typed URL, another in-page link). Back and
  // Forward to entries without a remembered position also fire hashchange,
  // after the browser has restored that entry: leave those alone. They are
  // recognised by the Navigation API where it exists, and otherwise because the
  // page is not where a fresh fragment jump would have put the section.
  let traversing = false;
  (window as any).navigation?.addEventListener?.("navigate", (e: { navigationType: string }) => {
    traversing = e.navigationType === "traverse";
  });
  addEventListener("hashchange", () => {
    const wasTraversal = traversing;
    traversing = false;
    const index = sectionInHash();
    if (restoring || index < 0 || wasTraversal || Math.abs(scrollY - nativeY(index)) > 2) return;
    goTo(index);
  });

  // Track the page from the start, before handling the initial fragment.
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", () => { measure(); update(); });
  new ResizeObserver(() => { measure(); update(); }).observe(document.body);

  measure();
  // A shared link such as /#good-fit: the browser jumps to the fragment
  // natively, and may do so after this script, around `load`. Land on the
  // mapped position now, then again at `load` and on the frame after it, as
  // long as the page is still where we or the native jump put it (anything
  // else means the reader has scrolled). Fonts and images can move the layout
  // until `load`, so re-measure each time.
  const opened = sectionInHash();
  if (opened > 0) {
    let landed = -1;
    const reland = () => {
      const untouched = landed < 0 || Math.abs(scrollY - landed) <= 2 || Math.abs(scrollY - nativeY(opened)) <= 2;
      if (!untouched) return;
      measure();
      goTo(opened, "instant");
      landed = scrollY;
      update();
    };
    reland();
    addEventListener("load", () => {
      reland();
      requestAnimationFrame(() => setTimeout(reland, 0));
    }, { once: true });
  }
  update();
</script>

<style>
  /* ── The strip (wide screens) ── */
  .gauge {
    --depth: 0;
    --width: 4rem;
    position: fixed;
    /* The strip runs the full height; its content starts at --top, the
       header's top (below the announcement bar until the header sticks), so
       the readout lines up with the header. */
    inset: 0 0 0 auto;
    padding-top: var(--top, 0px);
    z-index: 6;
    width: var(--width);
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--olf-border-subtle);
    background: linear-gradient(color-mix(in srgb, var(--water-now) 70%, transparent), color-mix(in srgb, var(--water-now-end) 70%, transparent));
    backdrop-filter: blur(6px);
  }

  /* Rolling readout: each digit is a column of 0–9 shifted by --digit lines. */
  /* Same height as the header (--head, border included), so their bottom
     borders form one line. */
  .readout {
    box-sizing: border-box;
    height: var(--head, 4.3rem);
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--olf-space-1);
    border-bottom: 1px solid var(--olf-border-subtle);
  }
  .caption {
    font: 500 0.5625rem / 1 var(--olf-font-mono);
    letter-spacing: var(--olf-tracking-label);
    text-transform: uppercase;
    color: var(--olf-text-muted);
  }
  .value {
    display: flex;
    align-items: baseline;
    font: 500 1rem / 1.25 var(--olf-font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--olf-highlight);
  }
  .roll {
    --digit: 0;
    display: flex;
    flex-direction: column;
    height: 1.25em;
    overflow: hidden;
  }
  .roll span {
    translate: 0 calc(var(--digit) * -100%);
    transition: translate var(--olf-duration) var(--olf-ease);
  }
  .unit {
    margin-left: 0.15em;
    font-size: 0.6875rem;
    color: var(--olf-text-muted);
  }

  /* The ruler is static and spans the whole page: 0 m at the top, the deepest
     section at the bottom, inside --pad-top / --pad-bottom (in rem, read by
     the script).
     The level moves down it like a scrollbar thumb. */
  .window {
    --pad-top: 1.25rem;
    --pad-bottom: 1.25rem;
    position: relative;
    flex: 1;
    overflow: hidden;
    cursor: crosshair;
    touch-action: none;
  }
  .gauge[data-dragging] .window { cursor: grabbing; }
  .ruler {
    position: absolute;
    inset: 0;
    container-type: size;
  }
  /* A depth's position on the ruler: m metres down the padded span. */
  .tick,
  .ruler li {
    position: absolute;
    top: calc(var(--pad-top) + (100% - var(--pad-top) - var(--pad-bottom)) * var(--m) / var(--max));
  }
  .tick {
    right: 0;
    width: 0.375rem;
    height: 1px;
    background: var(--olf-border-default);
  }
  .tick.mid { width: 0.75rem; background: var(--olf-border-strong); }
  .tick.major { width: 1.25rem; background: var(--olf-text-muted); }

  .ruler ol { margin: 0; padding: 0; list-style: none; }
  .ruler li {
    left: 0;
    right: 0;
  }
  /* Each depth sits just above its major tick, so the reading line never
     crosses it. */
  .ruler a {
    position: absolute;
    left: var(--olf-space-2);
    top: -1rem;
    font: 500 0.5625rem / 0.8rem var(--olf-font-mono);
    letter-spacing: 0.04em;
    color: var(--olf-text-muted);
    text-decoration: none;
  }
  .ruler a:hover { color: var(--olf-text-primary); }
  .ruler a[aria-current] { color: var(--olf-highlight); }

  /* The split-flap board floats in the corner below the header and beside
     the strip, the same gap (--board-gap) from both: one tile in a housing,
     as wide as the longest name (--chars), in the water's colour. */
  .board {
    --flap-h: 1.75rem;
    --board-gap: 0.75rem;
    /* The water itself, so the board sits in the page's colour. */
    --board-housing: var(--water-now);
    --board-edge: color-mix(in srgb, var(--water-now), white 15%);
    --board-tile: var(--water-now);
    --board-hinge: color-mix(in srgb, var(--water-now), black 12%);
    --board-ink: var(--abyss-50);
    --board-shadow: rgb(0 0 0 / 0.5);
    position: absolute;
    top: calc(var(--top, 0px) + var(--head, 4.3rem) + var(--board-gap));
    right: calc(100% + var(--board-gap));
    box-sizing: content-box;
    width: calc(var(--chars) * (1ch + 0.08em) + 1.5rem);
    height: var(--flap-h);
    border: 0.3125rem solid var(--board-housing);
    border-radius: var(--olf-radius-md);
    outline: 1px solid var(--board-edge);
    box-shadow: 0 0.5rem 1.5rem -0.75rem var(--board-shadow);
    perspective: 20rem;
    font: 600 0.8125rem / var(--flap-h) var(--olf-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--board-ink);
    pointer-events: none;
  }
  .board[data-tone="shallow"] { --board-ink: var(--abyss-950); }
  /* Each half shows half of a full-height line of text. */
  .half {
    position: absolute;
    inset-inline: 0;
    height: 50%;
    overflow: hidden;
    display: flex;
    justify-content: center;
    background: var(--board-tile);
    backface-visibility: hidden;
  }
  .half > span { height: var(--flap-h); white-space: nowrap; }
  .half.top { top: 0; border-radius: 3px 3px 0 0; transform-origin: 50% 100%; }
  .half.bottom { bottom: 0; border-radius: 0 0 3px 3px; transform-origin: 50% 0; }
  .half.bottom > span { margin-top: calc(var(--flap-h) / -2); }
  /* The hinge: a dark line between the halves. */
  .board::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    z-index: 2;
    height: 1px;
    background: var(--board-hinge);
  }
  .fold { visibility: hidden; z-index: 1; }
  .board.flipping .fold { visibility: visible; }
  .board.flipping .fold.top { animation: fold-top 0.18s ease-in forwards; }
  .board.flipping .fold.bottom {
    transform: rotateX(90deg);
    animation: fold-bottom 0.18s ease-out 0.18s forwards;
  }
  @keyframes fold-top {
    to { transform: rotateX(-90deg); filter: brightness(0.55); }
  }
  @keyframes fold-bottom {
    from { transform: rotateX(90deg); filter: brightness(1.4); }
    to { transform: rotateX(0); filter: none; }
  }

  /* The level: the current depth on the static ruler, i.e. the scrollbar's
     thumb, with a grip to drag and the water filled down to it. */
  .level {
    --at: calc(var(--pad-top) + (100% - var(--pad-top) - var(--pad-bottom)) * var(--depth) / var(--max));
