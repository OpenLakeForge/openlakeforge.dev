---
import { docsHref, quickstartHref } from "../../lib/nav";
---

<section class="wrap section" id="get-started">
  <div class="section-head center">
    <p class="eyebrow">Get started</p>
    <h2 class="display">The lake is yours.<br /><span class="accent">We bring the forge.</span></h2>
    <p class="lede">
      Docker and uv are all you need. <code>olf</code> provisions its own pinned Terraform, Helm, kubectl and kind.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={quickstartHref}>Read the quick start <span aria-hidden="true">→</span></a>
      <a class="btn btn-secondary" href={docsHref}>Browse the docs <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .section-head { max-width: 44rem; margin-bottom: 0; }
  .actions { justify-content: center; margin-top: var(--olf-space-4); }
  .lede code { font-family: var(--olf-font-mono); font-size: 0.9em; color: var(--olf-link); }
</style>
