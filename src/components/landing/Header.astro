---
import Mark from "../Mark.astro";
import { headerLinks, repositoryUrl } from "../../lib/nav";
import { release } from "../../data/landing";
---

<div class="announcement" data-tone="shallow">
  <p>
    <span class="version">v{release.version}</span>
    <span class="note">{release.note}</span>
    <a href="/changelog/">Read the changelog →</a>
  </p>
</div>
<header>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="OpenLakeForge home">
      <Mark size="2rem" />
      <span class="wordmark" translate="no">Open<span>Lake</span>Forge</span>
    </a>
    <nav aria-label="Main">
      {headerLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
      <a href={repositoryUrl}>GitHub ↗</a>
    </nav>
    <button class="theme" type="button" aria-label="Switch between dark and light theme">
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21 14.5A8.5 8.5 0 0 1 9.5 3a.5.5 0 0 0-.6-.6A10 10 0 1 0 21.6 15.1a.5.5 0 0 0-.6-.6Z" /></svg>
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
  </div>
</header>

<script>
  // Same key as Starlight's theme picker, so the docs follow the choice.
  document.querySelector("header .theme")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("starlight-theme", next); } catch {}
  });
</script>

<style>
  .announcement {
    position: relative;
    z-index: 7; /* above the depth gauge (DepthGauge.astro), which starts below it */
    /* Opaque, so the gauge never shows through. */
    background: linear-gradient(var(--olf-bg-accent-subtle), var(--olf-bg-accent-subtle)), var(--water-top);
    border-bottom: 1px solid var(--olf-border-subtle);
  }
  /* The page keeps a 4rem column free for the gauge here (DepthGauge.astro):
     the banner still spans the whole width. */
  @media (width > 64rem) and (height >= 30rem) {
    .announcement { margin-right: -4rem; }
  }
  .announcement p {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--olf-space-2) var(--olf-space-3);
    margin: 0;
    padding: var(--olf-space-2) var(--olf-space-4);
    font-size: var(--olf-text-small);
    color: var(--olf-text-secondary);
  }
  .version { font-family: var(--olf-font-mono); color: var(--olf-text-primary); }
  .announcement a { text-decoration: none; }
  header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--water-now) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--olf-border-subtle);
  }
  .bar { display: flex; align-items: center; gap: var(--olf-space-8); padding-top: var(--olf-space-4); padding-bottom: var(--olf-space-4); }
  .brand { display: flex; align-items: center; gap: var(--olf-space-3); color: var(--olf-text-primary); text-decoration: none; }
  .wordmark { font: 700 var(--olf-text-h4) / 1 var(--olf-font-heading); letter-spacing: -0.01em; }
  .wordmark span { color: var(--olf-highlight); }
  nav { display: flex; gap: var(--olf-space-8); margin-left: auto; }
  nav a {
    font: 500 0.8125rem / 1 var(--olf-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--olf-text-secondary);
    text-decoration: none;
  }
  nav a:hover { color: var(--olf-text-primary); }
  .theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--olf-border-default);
    border-radius: var(--olf-radius-md);
    background: transparent;
    color: var(--olf-text-secondary);
    cursor: pointer;
  }
  .theme:hover { color: var(--olf-text-primary); border-color: var(--olf-border-strong); }
  :global(:root[data-theme="dark"]) .sun,
  :global(:root[data-theme="light"]) .moon { display: none; }
  @media (max-width: 48rem) {
    .note { display: none; }
    .bar { gap: var(--olf-space-4); }
    nav { gap: var(--olf-space-4); }
    nav a:not(:first-child) { display: none; }
  }
</style>
