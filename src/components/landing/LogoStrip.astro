---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { components } from "../../data/landing";

// Logos copied from openlakeforge's docs/architecture/diagrams/src/overview/logos.json,
// which records where each one comes from.
const files = import.meta.glob<ImageMetadata>("../../assets/logos/*", { eager: true, import: "default" });
const logo = (file: string) => files[`../../assets/logos/${file}`];
---

<section class="wrap strip" aria-labelledby="strip-title">
  <p id="strip-title" class="eyebrow muted">Assembled from open source you already know</p>
  <ul>
    {components.map(({ name, file }) => (
      <li>
        <span class="tile"><Image src={logo(file)} alt="" width={36} densities={[1, 2]} loading="lazy" /></span>
        <span class="name">{name}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .strip { display: flex; flex-direction: column; align-items: center; gap: var(--olf-space-8); padding-top: var(--olf-space-16); }
  .muted { color: var(--olf-text-muted); text-align: center; }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--olf-space-6) var(--olf-space-10);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li { display: flex; flex-direction: column; align-items: center; gap: var(--olf-space-3); }
  .tile {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--olf-radius-lg);
    background: var(--abyss-50);
    box-shadow: inset 0 0 0 1px rgb(11 34 53 / 0.08);
  }
  .tile img { width: 2.25rem; height: 2.25rem; object-fit: contain; }
  .name { font-size: var(--olf-text-small); color: var(--olf-text-secondary); }
  @media (max-width: 48rem) {
    ul { gap: var(--olf-space-5); }
    .tile { width: 3rem; height: 3rem; }
    .tile img { width: 1.875rem; height: 1.875rem; }
  }
</style>
