---
/**
 * Layout of the presentation page. It is not a Starlight page, but it shares
 * Starlight's theme: the same tokens, and the same stored preference
 * (localStorage "starlight-theme"), so landing and docs never disagree.
 */
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/landing.css";
import Header from "../components/landing/Header.astro";
import Footer from "../components/landing/Footer.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      // Before first paint: the stored choice, else the OS preference.
      try {
        const stored = localStorage.getItem("starlight-theme");
        const theme = stored === "light" || stored === "dark" ? stored
          : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // How deep the viewport's top and bottom edges sit, 0 to 1, for --water-now.
      const root = document.documentElement;
      const dive = () => {
        root.style.setProperty("--dive", (scrollY / root.scrollHeight).toFixed(4));
        root.style.setProperty("--dive-end", ((scrollY + innerHeight) / root.scrollHeight).toFixed(4));
      };
      addEventListener("scroll", dive, { passive: true });
      addEventListener("resize", dive);
      dive();

      // The pointer is a stick trailed through the water: a small height-field
      // wave simulation (the jQuery Ripples algorithm) on a grid of 4 px
      // cells. The pointer pushes the surface down along its path; the waves
      // spread, cross and fade by themselves. Drawn like toon water (Wind
      // Waker, Ghibli), to match the page's flat style: a line along each
      // crest's and trough's contour, in the hero rings' colour, and a faint
      // flat shade in the deep troughs. The canvas is drawn at 2 px, heights
      // interpolated between cells, so the lines stay smooth.
      if (matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
        const cell = 4, pixel = 2, sub = cell / pixel;
        const canvas = document.createElement("canvas");
        canvas.className = "wake";
        canvas.setAttribute("aria-hidden", "true");
        document.body.append(canvas);
        const ctx = canvas.getContext("2d");
        let cols, rows, now, before, height, slope, active, image;
        const fit = () => {
          cols = Math.ceil(innerWidth / cell);
          rows = Math.ceil(innerHeight / cell);
          canvas.width = cols * sub;
          canvas.height = rows * sub;
          now = new Float32Array(cols * rows);
          before = new Float32Array(cols * rows);
          height = new Float32Array(cols * rows);
          slope = new Float32Array(cols * rows);
          active = new Uint8Array(cols * rows);
          image = ctx.createImageData(canvas.width, canvas.height);
        };
        fit();
        addEventListener("resize", fit);
        let line = [92, 201, 255], opacity = 0.22, shade = 1, running = false, last = null;
        let drawn = null; // the canvas rectangle drawn last frame, to clear
        const covers = ".card, .chart, .terminal, table, .tile, .btn, .copy, body > header, .announcement, [data-gauge], [data-jump]";
        const push = (x, y) => {
          const cx = Math.round(x / cell), cy = Math.round(y / cell);
          for (let dy = -2; dy <= 2; dy++) for (let dx = -2; dx <= 2; dx++) {
            const d2 = (dx * dx + dy * dy) / 4; // a round stick, softer at its edge
            if (d2 < 1 && cx + dx > 0 && cx + dx < cols - 1 && cy + dy > 0 && cy + dy < rows - 1) now[(cy + dy) * cols + cx + dx] -= 0.05 * (1 - d2);
          }
        };
        const smooth = (a, b, v) => { const t = Math.min(Math.max((v - a) / (b - a), 0), 1); return t * t * (3 - 2 * t); };
        const frame = () => {
          // Only the moving water is drawn: the cells' bounding box.
          let energy = 0, x1 = cols, y1 = rows, x2 = 0, y2 = 0;
          for (let y = 1; y < rows - 1; y++) for (let x = 1; x < cols - 1; x++) {
            const i = y * cols + x;
            const h = ((now[i - 1] + now[i + 1] + now[i - cols] + now[i + cols]) / 2 - before[i]) * 0.94;
            before[i] = h;
            if (Math.abs(h) > 0.002) { x1 = Math.min(x1, x); x2 = Math.max(x2, x); y1 = Math.min(y1, y); y2 = Math.max(y2, y); }
            energy = Math.max(energy, Math.abs(h));
          }
          [now, before] = [before, now];
          for (let i = cols + 1; i < now.length - cols - 1; i++) {
            // Smoothed with its neighbours, so the simulation's grain does not fray the lines.
            height[i] = (4 * now[i] + now[i - 1] + now[i + 1] + now[i - cols] + now[i + cols]) / 8;
            slope[i] = Math.hypot(now[i + 1] - now[i - 1], now[i + cols] - now[i - cols]) / 2;
            active[i] = slope[i] > 0.015 || height[i] < -0.12 ? 1 : 0; // could show foam or shade
          }
          const px = image.data, w = canvas.width;
          if (drawn) for (let ry = drawn.y; ry < drawn.y2; ry++) px.fill(0, (ry * w + drawn.x) * 4, (ry * w + drawn.x2) * 4);
          const box = x2 >= x1 ? { x: (x1 - 1) * sub, y: (y1 - 1) * sub, x2: (x2 + 2) * sub, y2: (y2 + 2) * sub } : null;
          for (let ry = box ? box.y : 0; ry < (box ? box.y2 : 0); ry++) {
            const fy = Math.min(Math.max((ry + 0.5) / sub - 0.5, 0), rows - 1.001), y0 = fy | 0, ty = fy - y0;
            for (let rx = box.x; rx < box.x2; rx++) {
              const fx = Math.min(Math.max((rx + 0.5) / sub - 0.5, 0), cols - 1.001), x0 = fx | 0, tx = fx - x0;
              const i = y0 * cols + x0, o = (ry * w + rx) * 4;
              if (!(active[i] | active[i + 1] | active[i + cols] | active[i + cols + 1])) continue; // calm water: stays clear
              const mix = (a) => (a[i] * (1 - tx) + a[i + 1] * tx) * (1 - ty) + (a[i + cols] * (1 - tx) + a[i + cols + 1] * tx) * ty;
              const h = mix(height), s = mix(slope);
              // Distance, in cells, to the crest or trough contour (height over
              // slope), so the line keeps one width however steep the wave;
              // only where the surface still slopes, or a flattening wave
              // would sit on the contour level and blot into patches.
              const d = Math.abs((Math.abs(h) - 0.06) / Math.max(s, 0.01));
              const foam = (1 - smooth(0.35, 0.6, d)) * smooth(0.015, 0.03, s);
              if (foam > 0.01) { px[o] = line[0]; px[o + 1] = line[1]; px[o + 2] = line[2]; px[o + 3] = foam * opacity * 255; }
              else { px[o] = 12; px[o + 1] = 46; px[o + 2] = 82; px[o + 3] = smooth(0.12, 0.15, -h) * opacity * 128 * shade; } // lake-900 shade
            }
          }
          const dirty = [box, drawn].filter(Boolean);
          if (dirty.length) {
            const x = Math.min(...dirty.map((b) => b.x)), y = Math.min(...dirty.map((b) => b.y));
            ctx.putImageData(image, 0, 0, x, y, Math.max(...dirty.map((b) => b.x2)) - x, Math.max(...dirty.map((b) => b.y2)) - y);
          }
          drawn = box;
          // The wake runs under every panel: cut it out where one lies, even a
          // translucent one, so it never shows through cards, code or bars.
          ctx.save();
          ctx.globalCompositeOperation = "destination-out";
          ctx.setTransform(1 / pixel, 0, 0, 1 / pixel, 0, 0);
          ctx.beginPath();
          for (const el of document.querySelectorAll(covers)) {
            const r = el.getBoundingClientRect();
            if (r.bottom > 0 && r.top < innerHeight && r.width) ctx.roundRect(r.x, r.y, r.width, r.height, parseFloat(getComputedStyle(el).borderTopLeftRadius) || 0);
          }
          ctx.fill();
          ctx.restore();
          if (energy > 0.0005) requestAnimationFrame(frame);
          else { running = false; drawn = null; image.data.fill(0); ctx.clearRect(0, 0, canvas.width, canvas.height); }
        };
        addEventListener("pointermove", (e) => {
          const x = e.clientX, y = e.clientY;
          // Every cell along the path, so a fast stroke still leaves one wake.
          const steps = last ? Math.min(Math.ceil(Math.hypot(x - last.x, y - last.y) / cell), 50) : 1;
          for (let s = 1; s <= steps; s++) push(last ? last.x + (x - last.x) * s / steps : x, last ? last.y + (y - last.y) * s / steps : y);
          last = { x, y };
          if (!running) {
            running = true;
            // The hero rings' colour and opacity, read now so a theme switch follows.
            const style = getComputedStyle(root), hex = style.getPropertyValue("--olf-highlight").trim();
            if (/^#[0-9a-f]{6}$/i.test(hex)) line = [1, 3, 5].map((k) => parseInt(hex.slice(k, k + 2), 16));
            opacity = parseFloat(style.getPropertyValue("--contour-opacity")) || opacity;
            shade = root.dataset.theme === "light" ? 0 : 1; // on white, one light blue only
            requestAnimationFrame(frame);
          }
        }, { passive: true });
        addEventListener("pointerleave", () => { last = null; });
      }
    </script>
  </body>
</html>
