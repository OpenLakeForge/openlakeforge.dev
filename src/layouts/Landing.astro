---
/**
 * Layout of the presentation page. It is not a Starlight page, but it shares
 * Starlight's theme: the same tokens, and the same stored preference
 * (localStorage "starlight-theme"), so landing and docs never disagree.
 */
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/landing.css";
import Header from "../components/landing/Header.astro";
import Footer from "../components/landing/Footer.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      // Before first paint: the stored choice, else the OS preference.
      try {
        const stored = localStorage.getItem("starlight-theme");
        const theme = stored === "light" || stored === "dark" ? stored
          : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <!-- Cel shading for the pointer's wake: alpha cut into three flat bands. -->
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <filter id="toon" color-interpolation-filters="sRGB">
        <feComponentTransfer><feFuncA type="discrete" tableValues="0 0.25 0.6" /></feComponentTransfer>
      </filter>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // How deep the viewport's top and bottom edges sit, 0 to 1, for --water-now.
      const root = document.documentElement;
      const dive = () => {
        root.style.setProperty("--dive", (scrollY / root.scrollHeight).toFixed(4));
        root.style.setProperty("--dive-end", ((scrollY + innerHeight) / root.scrollHeight).toFixed(4));
      };
      addEventListener("scroll", dive, { passive: true });
      addEventListener("resize", dive);
      dive();

      // The pointer is a stick trailed through the water: a small height-field
      // wave simulation (the jQuery Ripples algorithm, on a 2D canvas at a
      // quarter of the screen's resolution). The pointer pushes the surface
      // down along its path; the waves spread, cross and fade by themselves.
      // Cel-shaded, to match the page's flat style: the canvas holds smooth
      // light and shade, and the #toon filter cuts them, at screen resolution,
      // into flat bands with crisp edges.
      if (matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
        const cell = 4;
        const canvas = document.createElement("canvas");
        canvas.className = "wake";
        canvas.setAttribute("aria-hidden", "true");
        document.body.append(canvas);
        const ctx = canvas.getContext("2d");
        let cols, rows, now, before, image;
        const fit = () => {
          cols = canvas.width = Math.ceil(innerWidth / cell);
          rows = canvas.height = Math.ceil(innerHeight / cell);
          now = new Float32Array(cols * rows);
          before = new Float32Array(cols * rows);
          image = ctx.createImageData(cols, rows);
        };
        fit();
        addEventListener("resize", fit);
        let light = [255, 255, 255], running = false, last = null;
        const push = (x, y) => {
          const cx = Math.round(x / cell), cy = Math.round(y / cell);
          for (let dy = -3; dy <= 3; dy++) for (let dx = -3; dx <= 3; dx++) {
            const d2 = (dx * dx + dy * dy) / 9; // a round stick, softer at its edge
            if (d2 < 1 && cx + dx > 0 && cx + dx < cols - 1 && cy + dy > 0 && cy + dy < rows - 1) now[(cy + dy) * cols + cx + dx] -= 0.05 * (1 - d2);
          }
        };
        const frame = () => {
          let energy = 0;
          for (let y = 1; y < rows - 1; y++) for (let x = 1; x < cols - 1; x++) {
            const i = y * cols + x;
            const h = ((now[i - 1] + now[i + 1] + now[i - cols] + now[i + cols]) / 2 - before[i]) * 0.97;
            before[i] = h;
            energy = Math.max(energy, Math.abs(h));
          }
          [now, before] = [before, now];
          const px = image.data;
          for (let i = 0; i < now.length - cols - 1; i++) {
            const slope = now[i] + now[i + 1] - now[i + cols] - now[i + cols + 1]; // lit from above
            const o = i * 4;
            // Shade stays under 2/3 alpha, so the filter only gives it the light band.
            if (slope > 0) { px[o] = light[0]; px[o + 1] = light[1]; px[o + 2] = light[2]; px[o + 3] = Math.min(slope * 1200, 255); }
            else { px[o] = 12; px[o + 1] = 46; px[o + 2] = 82; px[o + 3] = Math.min(-slope * 1200, 160); } // lake-900 shade
          }
          ctx.putImageData(image, 0, 0);
          if (energy > 0.0005) requestAnimationFrame(frame);
          else { running = false; ctx.clearRect(0, 0, cols, rows); }
        };
        addEventListener("pointermove", (e) => {
          const x = e.clientX, y = e.clientY;
          // Every cell along the path, so a fast stroke still leaves one wake.
          const steps = last ? Math.min(Math.ceil(Math.hypot(x - last.x, y - last.y) / cell), 50) : 1;
          for (let s = 1; s <= steps; s++) push(last ? last.x + (x - last.x) * s / steps : x, last ? last.y + (y - last.y) * s / steps : y);
          last = { x, y };
          if (!running) {
            running = true;
            const hex = getComputedStyle(root).getPropertyValue("--olf-highlight").trim();
            if (/^#[0-9a-f]{6}$/i.test(hex)) light = [1, 3, 5].map((k) => parseInt(hex.slice(k, k + 2), 16));
            requestAnimationFrame(frame);
          }
        }, { passive: true });
        addEventListener("pointerleave", () => { last = null; });
      }
    </script>
  </body>
</html>
