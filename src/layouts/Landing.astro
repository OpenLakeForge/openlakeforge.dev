---
/**
 * Layout of the presentation page. It is not a Starlight page, but it shares
 * Starlight's tokens. It has one look only, the lake (landing.css), built on
 * the dark theme: no theme switch here; the docs keep theirs.
 */
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/landing.css";
import Header from "../components/landing/Header.astro";
import Footer from "../components/landing/Footer.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // The water down the page (landing.css): where the thermocline sits,
      // just under the hero, and the colour behind the viewport's top and
      // bottom edges, for the fixed bars. Each fixed control takes the shallow
      // tone while the water behind it is above the thermocline's middle: no
      // colour reads on both waters. The header and the board are painted
      // with --water-now, the water at the viewport's top, so they follow
      // that; the gauge runs the viewport's height, so its readout and every
      // tick and label follow their own position. The markup starts them all
      // shallow, right at the surface and without JavaScript.
      const root = document.documentElement;
      const hero = document.querySelector<HTMLElement>(".hero");
      const painted = [...document.querySelectorAll<HTMLElement>("body > header, [data-board]")];
      const placed = [...document.querySelectorAll<HTMLElement>(
        "[data-gauge] .readout, [data-jump], [data-window] li, [data-window] .tick, [data-window] .level",
      )];
      let stops: [number, number[]][] = [];
      const rgb = (hex: string) => (/^#[0-9a-f]{6}$/i.test(hex) ? [1, 3, 5].map((k) => parseInt(hex.slice(k, k + 2), 16)) : [0, 0, 0]);
      const colorAt = (y: number, alpha = 1) => {
        let i = 1;
        while (i < stops.length - 1 && y > stops[i][0]) i++;
        const [y0, a] = stops[i - 1], [y1, b] = stops[i];
        let t = Math.min(Math.max((y - y0) / (y1 - y0 || 1), 0), 1);
        if (i === 2) t = t * t * (3 - 2 * t); // the thermocline's ease
        return `rgb(${a.map((v, k) => Math.round(v + (b[k] - v) * t)).join(" ")} / ${alpha})`;
      };
      // The page's gradient over the viewport, for the full-height gauge: its
      // ends, and the thermocline's eased fifths where they are on screen.
      const viewGradient = () => {
        const [t0, t1] = [stops[1][0], stops[2][0]];
        const ys = [0, 1, 2, 3, 4, 5].map((k) => t0 + ((t1 - t0) * k) / 5).filter((y) => y > scrollY && y < scrollY + innerHeight);
        return `linear-gradient(${[scrollY, ...ys, scrollY + innerHeight].map((y) => `${colorAt(y, 0.7)} ${Math.round(y - scrollY)}px`).join(", ")})`;
      };
      const dive = () => {
        // Off screen, the thermocline gives every control one tone. On screen,
        // read every position first, then write everything: a write before a
        // read would force a fresh style and layout pass for it.
        const middle = (stops[1][0] + stops[2][0]) / 2 - scrollY;
        const tone = (y: number) => (y < middle ? "shallow" : "deep");
        const tones = middle < 0 || middle > innerHeight
          ? placed.map(() => tone(0))
          : placed.map((el) => { const r = el.getBoundingClientRect(); return tone(r.top + r.height / 2); });
        const set = (el: HTMLElement, t: string) => { if (el.dataset.tone !== t) el.dataset.tone = t; };
        root.style.setProperty("--water-now", colorAt(scrollY));
        root.style.setProperty("--water-view", viewGradient());
        placed.forEach((el, i) => set(el, tones[i]));
        for (const el of painted) set(el, tone(0));
      };
      const measure = () => {
        const style = getComputedStyle(root), heroBottom = hero ? hero.getBoundingClientRect().bottom + scrollY : 0;
        const top = heroBottom - 24, bottom = heroBottom + 120; // inside the gap before the next section's text
        root.style.setProperty("--thermo-top", `${top}px`);
        root.style.setProperty("--thermo-bottom", `${bottom}px`);
        stops = ([[0, "--water-top"], [top, "--water-shallow"], [bottom, "--water-deep"], [root.scrollHeight, "--water-bottom"]] as const)
          .map(([y, name]) => [y, rgb(style.getPropertyValue(name).trim())]);
        dive();
      };
      addEventListener("scroll", dive, { passive: true });
      addEventListener("resize", measure); // a height-only resize leaves the body's size alone
      new ResizeObserver(measure).observe(document.body);
      measure();
    </script>
  </body>
</html>
