---
/**
 * Layout of the presentation page. It is not a Starlight page, but it shares
 * Starlight's theme: the same tokens, and the same stored preference
 * (localStorage "starlight-theme"), so landing and docs never disagree.
 */
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/landing.css";
import Header from "../components/landing/Header.astro";
import Footer from "../components/landing/Footer.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      // Before first paint: the stored choice, else the OS preference.
      try {
        const stored = localStorage.getItem("starlight-theme");
        const theme = stored === "light" || stored === "dark" ? stored
          : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // How deep the viewport's top and bottom edges sit, 0 to 1, for --water-now.
      const root = document.documentElement;
      const dive = () => {
        root.style.setProperty("--dive", (scrollY / root.scrollHeight).toFixed(4));
        root.style.setProperty("--dive-end", ((scrollY + innerHeight) / root.scrollHeight).toFixed(4));
      };
      addEventListener("scroll", dive, { passive: true });
      addEventListener("resize", dive);
      dive();

      // The pointer is a stick trailed through the water. Every few pixels it
      // drops a point that drifts away on both sides, across its heading; each
      // side's points, joined by smooth curves, draw one arm of the wake, and
      // a bow wave arcs in front of the newest point to close the V.
      if (matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
        const life = 1400;
        const canvas = document.createElement("canvas");
        canvas.className = "wake";
        canvas.setAttribute("aria-hidden", "true");
        document.body.append(canvas);
        const ctx = canvas.getContext("2d");
        const fit = () => {
          canvas.width = innerWidth * devicePixelRatio;
          canvas.height = innerHeight * devicePixelRatio;
        };
        fit();
        addEventListener("resize", fit);
        const drops = [];
        let last = null;
        let hx = 1, hy = 0; // the smoothed heading, so the arms do not jitter
        // Opens fast near the stick, then slower, with a slight swell.
        const radius = (d, age) => 12 + 60 * Math.sqrt(age) + 2.5 * Math.sin(age * 9 + d.born / 120);
        const draw = (now) => {
          while (drops.length && now - drops[0].born > life) drops.shift();
          ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
          ctx.clearRect(0, 0, innerWidth, innerHeight);
          ctx.lineCap = "round";
          const ages = drops.map((d) => (now - d.born) / life);
          const style = (i) => {
            ctx.strokeStyle = drops[i].color;
            ctx.globalAlpha = (1 - ages[i]) ** 1.5 * 0.55;
            ctx.lineWidth = 0.8 + (1 - ages[i]);
          };
          for (const side of [-1, 1]) {
            const pts = drops.map((d, i) => {
              const r = radius(d, ages[i]) * side;
              return [d.x - d.hy * r, d.y + d.hx * r];
            });
            const mid = (i) => [(pts[i][0] + pts[i + 1][0]) / 2, (pts[i][1] + pts[i + 1][1]) / 2];
            for (let i = 1; i < pts.length; i++) {
              const a = drops[i - 1], b = drops[i];
              if (Math.hypot(b.x - a.x, b.y - a.y) > 80) continue; // the pointer jumped: a new wake
              style(i);
              ctx.beginPath();
              ctx.moveTo(...(i === 1 ? pts[0] : mid(i - 1)));
              ctx.quadraticCurveTo(...pts[i], ...(i === pts.length - 1 ? pts[i] : mid(i)));
              ctx.stroke();
            }
          }
          const head = drops.length - 1;
          if (head >= 0) {
            const d = drops[head];
            const h = Math.atan2(d.hy, d.hx);
            style(head);
            ctx.beginPath();
            ctx.arc(d.x, d.y, radius(d, ages[head]), h - Math.PI / 2, h + Math.PI / 2);
            ctx.stroke();
          }
          if (drops.length) requestAnimationFrame(draw);
        };
        addEventListener("pointermove", (e) => {
          const x = e.clientX, y = e.clientY;
          if (last) {
            const step = Math.hypot(x - last.x, y - last.y);
            if (step < 8) return;
            hx += ((x - last.x) / step - hx) * 0.35;
            hy += ((y - last.y) / step - hy) * 0.35;
            const n = Math.hypot(hx, hy) || 1;
            hx /= n;
            hy /= n;
          }
          last = { x, y };
          const color = getComputedStyle(root).getPropertyValue("--olf-highlight");
          drops.push({ x, y, hx, hy, born: performance.now(), color });
          if (drops.length === 1) requestAnimationFrame(draw);
        }, { passive: true });
      }
    </script>
  </body>
</html>
