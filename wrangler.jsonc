// Cloudflare hosting, as code: a Worker that only serves the static build.
// Deployed by Cloudflare Workers Builds, connected to this repository:
//   build command                     npm run build
//   deploy command (main)             npx wrangler deploy
//   deploy command (other branches)   npx wrangler preview   (one Preview per branch)
// The Worker's name in the Cloudflare dashboard must equal "name" below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openlakeforge-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // openlakeforge.dev is a zone in the same Cloudflare account; wrangler
  // creates the DNS record and certificate for the custom domain.
  "routes": [{ "pattern": "openlakeforge.dev", "custom_domain": true }],
  // No *.workers.dev copy of the production site: one public URL only.
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview` (branch builds). Empty: previews inherit
  // the assets and compatibility settings above.
  "previews": {}
}
